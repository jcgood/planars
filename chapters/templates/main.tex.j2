\#{ The volume, from volume.yaml, or one chapter of it on its own. Context:
   file (this file's name), title, parts (folder names, in order: every
   part for main.tex, one for a chapter's own file), languages (every
   language chapter in the volume, whose values are loaded). }
\BLOCK{if file == "main.tex"}
% main.tex: the volume, from volume.yaml.
\BLOCK{else}
% \VAR{file}: the \VAR{parts[0]} chapter on its own, for whoever writes it;
% main.tex is the whole volume.
\BLOCK{endif}
% Written by `python -m coding build-chapters`; never edit it by hand
% (change the title or the parts in volume.yaml, then rebuild).
% Compile it here, in .papers/: latexmk -pdf \VAR{file}
% The document class is a stand-in for the venue's (De Gruyter's dgruyter).
\documentclass{book}
\usepackage[T1]{fontenc}
\usepackage{planarschapter}
\usepackage{planarsvenue}
\BLOCK{for L in languages}
\input{\VAR{path(L ~ "/values")}}
\BLOCK{endfor}
\title{\VAR{title}}
\begin{document}
\maketitle
\tableofcontents
\BLOCK{for p in parts}
\include{\VAR{path(p ~ "/chapter")}}
\BLOCK{endfor}
\end{document}
