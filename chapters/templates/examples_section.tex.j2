\#{ The examples the annotation gives for one class in a language chapter,
   by construction and row, each through the venue's example macro: a few
   rows per construction, and how many more the annotation has.
   Context: display_name, constructions (list of dicts: name, rows: list of
   dicts: row, examples: list of Tex; more: rows with an example not
   shown). }
\BLOCK{if constructions}
\par\medskip\noindent\textbf{Examples from the annotation (\VAR{display_name})}\par

\BLOCK{for c in constructions}
\BLOCK{for r in c.rows}
\noindent\texttt{\VAR{c.name|name}}: \VAR{r.row}
\BLOCK{for e in r.examples}
\VAR{e}
\BLOCK{endfor}
\BLOCK{endfor}
\BLOCK{if c.more}
\noindent\textit{\VAR{c.more} more \BLOCK{if c.more == 1}row\BLOCK{else}rows\BLOCK{endif} of \texttt{\VAR{c.name|name}} give examples, in the annotation.}\par\medskip

\BLOCK{endif}
\BLOCK{endfor}
\BLOCK{else}
